{
  "name": "loremapper",
  "private": true,
  "version": "1.2.3-alpha.1",
  "description": "Local-first fantasy world map editor: sculpt terrain, paint biomes, place illustrated assets, draw borders and fog of war.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
